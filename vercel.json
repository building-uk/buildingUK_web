{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "building.uk.com"
        }
      ],
      "destination": "https://www.building.uk.com/:path*",
      "permanent": true
    },
    {
      "source": "/services/residential-refurbishment",
      "destination": "/services/whole-home-refurbishment",
      "permanent": true
    },
    {
      "source": "/services/restoration-services",
      "destination": "/services/whole-home-refurbishment",
      "permanent": true
    },
    {
      "source": "/services/commercial-services",
      "destination": "/services/home-repairs-maintenance",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
